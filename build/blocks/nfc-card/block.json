{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ghostlabs/undercard-nfc",
  "title": "Undercard: NFC Profile",
  "category": "widgets",
  "icon": "smartphone",
  "description": "An author card in the NFC Profile family — a digital business card with a bio and a save action.",
  "keywords": [
    "author",
    "profile",
    "card",
    "byline",
    "vcard"
  ],
  "textdomain": "ghostlabs-undercard",
  "supports": {
    "html": false,
    "align": [
      "left",
      "center",
      "right",
      "wide"
    ],
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": "vertical",
      "enum": [
        "vertical",
        "horizontal",
        "row",
        "chip"
      ]
    },
    "variation": {
      "type": "string",
      "default": "ember",
      "enum": [
        "ember",
        "onyx"
      ]
    },
    "authorId": {
      "type": "number",
      "default": 0
    },
    "avatar": {
      "type": "string",
      "default": "photo",
      "enum": [
        "monogram",
        "photo"
      ]
    },
    "focalPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "photoScale": {
      "type": "number",
      "default": 1
    },
    "headingLevel": {
      "type": "number",
      "default": 2,
      "enum": [
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "usesContext": [
    "postId"
  ],
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}